    {
      "parameters": {
        "jsCode": "const uniqueUrls = new Set();\nconst filteredItems = [];\nconst fortyEightHoursAgo = Date.now() - 48 * 60 * 60 * 1000;\n\nfor (const item of $input.all()) {\n  const json = item.json;\n  const url = json.link || json.url;\n  const pubDateStr = json.pubDate || json.date || json.isoDate || json.published;\n  const pubDate = pubDateStr ? new Date(pubDateStr).getTime() : Date.now();\n  \n  if (!url || uniqueUrls.has(url)) continue;\n  if (pubDate < fortyEightHoursAgo) continue;\n\n  uniqueUrls.add(url);\n  filteredItems.push({\n    json: {\n      title: json.title || 'Untitled',\n      link: url,\n      pubDate: new Date(pubDate).toISOString(),\n      description: json.contentSnippet || json.content || json.description || ''\n    }\n  });\n}\n\nreturn filteredItems.slice(0, 20);"
      },
